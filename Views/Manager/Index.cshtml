@{
    ViewData["Title"] = "Dashboard";
    Layout = "_ManagerLayout";
    var aps = ViewBag.AppointmentList as List<Appointment>;
    var doctors = ViewBag.DoctorList as List<Doctor>;
    var users = ViewBag.UserList as List<User>;
    var depts = ViewBag.DeptList as List<Department>;
    DateOnly from = (DateOnly)ViewBag.From;
    DateOnly to = (DateOnly)ViewBag.To;

    int total = aps.Count;
    int cancelled = aps.Count(x => x.Status == "CANCELLED");
    string[] statuses = { "WAITING", "IN_PROGRESS", "COMPLETED", "NO_SHOW", "CANCELLED" };
    var days = aps.GroupBy(x => x.AppointmentDate).OrderBy(g => g.Key).ToList();
}

<h3>📊 Dashboard ผู้ป่วยและการจอง</h3>

@if (ViewBag.Status != null)
{
    <div class="alert alert-warning">@ViewBag.Status</div>
}

<form asp-controller="Manager" asp-action="Index" method="get" class="row g-2 mb-4">
    <input type="hidden" name="UserId" value="@ViewBag.UserId" />
    <div class="col-md-3">
        <label class="form-label">ตั้งแต่วันที่</label>
        <input type="date" name="From" value="@from.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">ถึงวันที่</label>
        <input type="date" name="To" value="@to.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100">ดูข้อมูล</button>
    </div>
</form>

<p class="text-muted">
    ช่วงวันนัด: @from.ToString("dd/MM/yyyy") - @to.ToString("dd/MM/yyyy")
</p>

<div class="row mb-4">
    <div class="col-md-4 mb-3"><div class="card text-bg-primary"><div class="card-body">
        <div>การจองทั้งหมดในช่วงนี้</div><h3>@total คิว</h3>
    </div></div></div>
    <div class="col-md-4 mb-3"><div class="card text-bg-success"><div class="card-body">
        <div>การจองที่ไม่ถูกยกเลิก</div><h3>@(total - cancelled) คิว</h3>
    </div></div></div>
    <div class="col-md-4 mb-3"><div class="card text-bg-secondary"><div class="card-body">
        <div>ยกเลิก</div><h3>@cancelled คิว</h3>
    </div></div></div>
    <div class="col-md-4 mb-3"><div class="card text-bg-warning"><div class="card-body">
        <div>ผู้ป่วยทั้งหมดในระบบ</div><h3>@ViewBag.PatientTotal คน</h3>
    </div></div></div>
    <div class="col-md-4 mb-3"><div class="card"><div class="card-body">
        <div>ผู้ป่วยสมัครใหม่ในช่วงนี้</div><h3>@ViewBag.NewPatients คน</h3>
    </div></div></div>
    <div class="col-md-4 mb-3"><div class="card"><div class="card-body">
        <div>ผู้ป่วยที่จองในช่วงนี้</div><h3>@ViewBag.BookedPatients คน</h3>
    </div></div></div>
</div>

<div class="row">
    <div class="col-lg-6 mb-4">
        <h5>การจองแยกตามสถานะ</h5>
        <table class="table table-bordered table-striped">
            <thead><tr><th>สถานะ</th><th class="text-end">จำนวน</th><th style="width:40%">สัดส่วน</th></tr></thead>
            <tbody>
                @foreach (var st in statuses)
                {
                    int n = aps.Count(x => x.Status == st);
                    int pct = total == 0 ? 0 : n * 100 / total;
                    <tr>
                        <td>@st</td>
                        <td class="text-end">@n</td>
                        <td>
                            <div class="progress">
                                <div class="progress-bar" style="width:@(pct)%">@(pct)%</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-lg-6 mb-4">
        <h5>การจองแยกตามแผนก</h5>
        <table class="table table-bordered table-striped">
            <thead><tr><th>แผนก</th><th class="text-end">จำนวนการจอง</th></tr></thead>
            <tbody>
                @if (depts.Count == 0)
                {
                    <tr><td colspan="2" class="text-center text-muted">ไม่มีข้อมูลแผนก</td></tr>
                }
                @foreach (var dp in depts)
                {
                    int n = aps.Count(a => doctors.Any(d => d.DoctorId == a.DoctorId && d.DepartmentId == dp.DepartmentId));
                    <tr><td>@dp.DepartmentName</td><td class="text-end">@n</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mb-4">
        <h5>การจองแยกตามแพทย์</h5>
        <table class="table table-bordered table-striped">
            <thead><tr><th>แพทย์</th><th class="text-end">จำนวนการจอง</th></tr></thead>
            <tbody>
                @if (doctors.Count == 0)
                {
                    <tr><td colspan="2" class="text-center text-muted">ไม่มีข้อมูลแพทย์</td></tr>
                }
                @foreach (var d in doctors)
                {
                    var du = users.FirstOrDefault(x => x.UserId == d.UserId);
                    int n = aps.Count(a => a.DoctorId == d.DoctorId);
                    <tr>
                        <td>@(du != null ? du.FirstName + " " + du.LastName : "-")</td>
                        <td class="text-end">@n</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-lg-6 mb-4">
        <h5>การจองรายวัน</h5>
        <table class="table table-bordered table-striped">
            <thead><tr><th>วันที่นัด</th><th class="text-end">จำนวนการจอง</th></tr></thead>
            <tbody>
                @if (days.Count == 0)
                {
                    <tr><td colspan="2" class="text-center text-muted">ไม่มีการจองในช่วงที่เลือก</td></tr>
                }
                @foreach (var g in days)
                {
                    <tr><td>@g.Key.ToString("dd/MM/yyyy")</td><td class="text-end">@g.Count()</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>