@{
    ViewData["Title"] = "คิวผู้ป่วย";
    Layout = "_DoctorLayout";
    var list = ViewBag.AppointmentList as List<Appointment>;
    var patients = ViewBag.PatientList as List<Patient>;
    var users = ViewBag.UserList as List<User>;
    var lines = ViewBag.ServiceLines as List<AppointmentService>;
    var services = ViewBag.ServiceList as List<Service>;
    var paidIds = ViewBag.PaidIds as List<int> ?? new List<int>();
    DateOnly date = (DateOnly)ViewBag.Date;
    string dateText = date.ToString("yyyy-MM-dd");
    string status = ViewBag.FilterStatus as string ?? "ALL";
}

<h3>🩺 คิวผู้ป่วย</h3>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-bg-warning">
            <div class="card-body">
                <div>รอตรวจ</div>
                <h3>@ViewBag.WaitingCount คิว</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-bg-primary">
            <div class="card-body">
                <div>กำลังตรวจ</div>
                <h3>@ViewBag.InProgressCount คิว</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-bg-success">
            <div class="card-body">
                <div>ตรวจเสร็จแล้ว</div>
                <h3>@ViewBag.CompletedCount คิว</h3>
            </div>
        </div>
    </div>
</div>

<form asp-controller="DoctorPortal" asp-action="Index" method="get" class="row g-2 mb-3">
    <input type="hidden" name="UserId" value="@ViewBag.UserId" />
    <div class="col-md-3">
        <input type="date" name="Date" value="@dateText" class="form-control" />
    </div>
    <div class="col-md-3">
        <select name="Status" class="form-select">
            <option value="ALL" selected="@(status == "ALL")">ทุกสถานะ</option>
            <option value="WAITING" selected="@(status == "WAITING")">WAITING (รอตรวจ)</option>
            <option value="IN_PROGRESS" selected="@(status == "IN_PROGRESS")">IN_PROGRESS (กำลังตรวจ)</option>
            <option value="COMPLETED" selected="@(status == "COMPLETED")">COMPLETED (เสร็จแล้ว)</option>
            <option value="NO_SHOW" selected="@(status == "NO_SHOW")">NO_SHOW (ไม่มา)</option>
            <option value="CANCELLED" selected="@(status == "CANCELLED")">CANCELLED (ยกเลิก)</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100">ค้นหา</button>
    </div>
</form>

<table class="table table-bordered table-striped align-middle">
    <thead>
        <tr>
            <th>หมายเลขคิว</th>
            <th>เวลา</th>
            <th>ผู้ป่วย</th>
            <th>บริการ</th>
            <th>สถานะ</th>
            <th>จัดการ</th>
        </tr>
    </thead>
    <tbody>
        @if (list.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">ไม่มีคิวในวันที่เลือก</td>
            </tr>
        }
        @foreach (var a in list)
        {
            var pt = patients.FirstOrDefault(x => x.PatientId == a.PatientId);
            var pu = pt == null ? null : users.FirstOrDefault(y => y.UserId == pt.UserId);
            var svNames = lines.Where(l => l.AppointmentId == a.AppointmentId)
                               .Select(l => services.FirstOrDefault(s => s.ServiceId == l.ServiceId))
                               .Where(s => s != null)
                               .Select(s => s.ServiceName)
                               .ToList();
            <tr>
                <td>@a.QueueNo</td>
                <td>@a.AppointmentTime.ToString("HH:mm")</td>
                <td>@(pu != null ? pu.FirstName + " " + pu.LastName : "-")</td>
                <td class="small">@string.Join(", ", svNames)</td>
                <td>
                    @if (a.Status == "WAITING")
                    {
                        <span class="badge text-bg-warning">WAITING</span>
                    }
                    else if (a.Status == "IN_PROGRESS")
                    {
                        <span class="badge text-bg-primary">IN_PROGRESS</span>
                    }
                    else if (a.Status == "COMPLETED")
                    {
                        <span class="badge text-bg-success">COMPLETED</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">@a.Status</span>
                    }
                </td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-controller="DoctorPortal" asp-action="PatientInfo"
                       asp-route-UserId="@ViewBag.UserId" asp-route-AppointmentId="@a.AppointmentId">ข้อมูลผู้ป่วย</a>

                    @if (a.Status == "WAITING")
                    {
                        if (paidIds.Contains(a.AppointmentId))
                        {
                            <form asp-controller="DoctorPortal" asp-action="UpdateStatus" method="post" class="d-inline">
                                <input type="hidden" name="UserId" value="@ViewBag.UserId" />
                                <input type="hidden" name="AppointmentId" value="@a.AppointmentId" />
                                <input type="hidden" name="NewStatus" value="IN_PROGRESS" />
                                <button class="btn btn-sm btn-primary">เริ่มตรวจ</button>
                            </form>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">รอชำระเงิน/รอการเงินอนุมัติ</span>
                        }
                        <form asp-controller="DoctorPortal" asp-action="UpdateStatus" method="post" class="d-inline"
                              onsubmit="return confirm('บันทึกว่าผู้ป่วยไม่มาตามนัด?');">
                            <input type="hidden" name="UserId" value="@ViewBag.UserId" />
                            <input type="hidden" name="AppointmentId" value="@a.AppointmentId" />
                            <input type="hidden" name="NewStatus" value="NO_SHOW" />
                            <button class="btn btn-sm btn-outline-secondary">ไม่มาตามนัด</button>
                        </form>
                    }
                    @if (a.Status == "IN_PROGRESS")
                    {
                        <form asp-controller="DoctorPortal" asp-action="UpdateStatus" method="post" class="d-inline">
                            <input type="hidden" name="UserId" value="@ViewBag.UserId" />
                            <input type="hidden" name="AppointmentId" value="@a.AppointmentId" />
                            <input type="hidden" name="NewStatus" value="COMPLETED" />
                            <button class="btn btn-sm btn-success">ตรวจเสร็จ</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>