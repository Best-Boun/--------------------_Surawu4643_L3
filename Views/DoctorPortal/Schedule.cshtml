@{
    ViewData["Title"] = "ตารางนัดหมายของฉัน";
    Layout = "_DoctorLayout";
    var schedules = ViewBag.ScheduleList as List<DoctorSchedule>;
    var appointments = ViewBag.AppointmentList as List<Appointment>;
}

<h3>📅 ตารางนัดหมายของฉัน</h3>
<p class="text-muted">รอบเวลาที่เปิดไว้ตั้งแต่วันนี้เป็นต้นไป (ปรับตารางได้โดยผู้ดูแลตารางแพทย์)</p>

<table class="table table-bordered table-striped align-middle">
    <thead>
        <tr>
            <th>วันที่</th><th>เวลา</th><th class="text-center">จองแล้ว / รองรับ</th><th>สถานะรอบ</th><th></th>
        </tr>
    </thead>
    <tbody>
        @if (schedules.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-muted">ยังไม่มีรอบเวลา</td></tr>
        }
        @foreach (var s in schedules)
        {
            int booked = appointments.Count(x => x.ScheduleId == s.ScheduleId);
            <tr>
                <td>@s.ScheduleDate.ToString("dd/MM/yyyy")</td>
                <td>@s.StartTime.ToString("HH:mm") - @s.EndTime.ToString("HH:mm")</td>
                <td class="text-center">@booked / @s.MaxQueue</td>
                <td>
                    @if (s.Status == "OPEN")
                    {
                        <span class="badge text-bg-success">OPEN</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">@s.Status</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-controller="DoctorPortal" asp-action="Index"
                       asp-route-UserId="@ViewBag.UserId" asp-route-Date="@s.ScheduleDate.ToString("yyyy-MM-dd")">ดูคิววันนี้</a>
                </td>
            </tr>
        }
    </tbody>
</table>