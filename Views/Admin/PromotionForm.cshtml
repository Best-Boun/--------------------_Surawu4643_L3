@model ระบบจองคิวโรงพยาบาล.ViewModels.PromotionFormViewModel
@{
    bool isNew = Model.PromotionId == 0;
    ViewData["Title"] = isNew ? "เพิ่มโปรโมชั่น" : "แก้ไขโปรโมชั่น";
    Layout = "_AdminLayout";
}

<h3>@(isNew ? "➕ เพิ่มโปรโมชั่น" : "✏️ แก้ไขโปรโมชั่น")</h3>

@if (ViewBag.Status != null)
{
    <div class="alert alert-danger" style="max-width:650px">@ViewBag.Status</div>
}

<form asp-controller="Admin" asp-action="PromotionForm" method="post" style="max-width:650px">
    <input type="hidden" asp-for="AdminId" />
    <input type="hidden" asp-for="PromotionId" />

    <div class="mb-3">
        <label asp-for="PromotionName" class="form-label">ชื่อโปรโมชั่น</label>
        <input asp-for="PromotionName" class="form-control" required />
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="PromotionType" class="form-label">ประเภท (กำหนดวิธีตรวจสิทธิ์)</label>
            <select asp-for="PromotionType" class="form-select">
                <option value="">-- เลือกประเภท --</option>
                <option value="AGE">AGE (ผู้สูงอายุ)</option>
                <option value="HEALTH_PACKAGE">HEALTH_PACKAGE (แพ็กเกจตรวจสุขภาพ)</option>
                <option value="FAMILY">FAMILY (ครอบครัว)</option>
                <option value="WEB">WEB (จองผ่านเว็บ)</option>
                <option value="BIRTH_MONTH">BIRTH_MONTH (เดือนเกิด)</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="DiscountPercent" class="form-label">ส่วนลด (%)</label>
            <input asp-for="DiscountPercent" type="number" step="0.01" min="0" max="100" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="MinimumAge" class="form-label">อายุขั้นต่ำ (เฉพาะ AGE)</label>
            <input asp-for="MinimumAge" type="number" min="1" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="MinimumPerson" class="form-label">จำนวนคนขั้นต่ำ (เฉพาะ FAMILY)</label>
            <input asp-for="MinimumPerson" type="number" min="2" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="StartDate" class="form-label">วันที่เริ่ม (ไม่ใส่ = ไม่กำหนด)</label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndDate" class="form-label">วันที่สิ้นสุด (ไม่ใส่ = ไม่กำหนด)</label>
            <input asp-for="EndDate" type="date" class="form-control" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">รายละเอียด</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label">สถานะ</label>
        <select asp-for="Status" class="form-select">
            <option value="ACTIVE">ACTIVE (เปิดใช้งาน)</option>
            <option value="INACTIVE">INACTIVE (ปิดใช้งาน)</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">บันทึก</button>
    <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="PromotionList" asp-route-UserId="@Model.AdminId">ยกเลิก</a>
</form>