@model ระบบจองคิวโรงพยาบาล.ViewModels.ServiceFormViewModel
@{
    bool isNew = Model.ServiceId == 0;
    ViewData["Title"] = isNew ? "เพิ่มบริการ" : "แก้ไขบริการ";
    Layout = "_AdminLayout";
    var depts = ViewBag.DeptList as List<Department>;
}

<h3>@(isNew ? "➕ เพิ่มบริการ" : "✏️ แก้ไขบริการ")</h3>

@if (ViewBag.Status != null)
{
    <div class="alert alert-danger" style="max-width:650px">@ViewBag.Status</div>
}

<form asp-controller="Admin" asp-action="ServiceForm" method="post" style="max-width:650px">
    <input type="hidden" asp-for="AdminId" />
    <input type="hidden" asp-for="ServiceId" />

    <div class="mb-3">
        <label asp-for="DepartmentId" class="form-label">แผนก</label>
        <select asp-for="DepartmentId" class="form-select" required>
            <option value="">-- เลือกแผนก --</option>
            @foreach (var d in depts)
            {
                <option value="@d.DepartmentId">@d.DepartmentName</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="ServiceName" class="form-label">ชื่อบริการ</label>
        <input asp-for="ServiceName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">รายละเอียด</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Price" class="form-label">ราคา (บาท)</label>
            <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="ServiceType" class="form-label">ประเภท</label>
            <select asp-for="ServiceType" class="form-select">
                <option value="CONSULT">CONSULT (ตรวจ/ปรึกษา)</option>
                <option value="TREATMENT">TREATMENT (รักษา/หัตถการ)</option>
                <option value="HEALTH_PACKAGE">HEALTH_PACKAGE (แพ็กเกจตรวจสุขภาพ)</option>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Status" class="form-label">สถานะ</label>
            <select asp-for="Status" class="form-select">
                <option value="ACTIVE">ACTIVE</option>
                <option value="INACTIVE">INACTIVE</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">บันทึก</button>
    <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="ServiceList" asp-route-UserId="@Model.AdminId">ยกเลิก</a>
</form>