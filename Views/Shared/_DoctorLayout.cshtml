@{
    var ctl = Convert.ToString(ViewContext.RouteData.Values["controller"]);
    var act = Convert.ToString(ViewContext.RouteData.Values["action"]);
    string Cls(bool on) => on ? "mq-link active" : "mq-link";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Queue</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/mediqueue.css" asp-append-version="true" />
</head>
<body>
<div class="mq-app">

    <aside class="mq-sidebar">
        <div class="mq-brand">
            <span class="mq-brand-mark">🏥</span><span>MediQueue Thai</span>
        </div>

        <div class="mq-menu-title">สำหรับเจ้าหน้าที่</div>
        <nav>
            <a class="@(Cls(act == "Index" || act == "PatientInfo"))" asp-controller="DoctorPortal" asp-action="Index" asp-route-UserId="@ViewBag.UserId">🩺 คิวผู้ป่วยวันนี้</a>
            <a class="@(Cls(act == "Schedule"))" asp-controller="DoctorPortal" asp-action="Schedule" asp-route-UserId="@ViewBag.UserId">📅 ตารางนัดหมายของฉัน</a>
        </nav>

        <div class="mq-side-foot">
            <div class="mq-user">
                <span class="mq-avatar">👤</span>
                <div><b>แพทย์</b><small>เจ้าหน้าที่</small></div>
            </div>
            <a class="mq-link" asp-controller="Home" asp-action="Logout">🚪 ออกจากระบบ</a>
        </div>
    </aside>

    <div class="mq-main">
        <header class="mq-topbar">
            <div class="mq-crumb">หน้าหลัก &rsaquo; <b>@ViewData["Title"]</b></div>
            <span class="mq-role">แพทย์</span>
        </header>
        <main class="mq-content">
            @RenderBody()
        </main>
        <footer class="mq-footer">© @DateTime.Now.Year MediQueue Thai - ระบบจองคิวโรงพยาบาล</footer>
    </div>

</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>