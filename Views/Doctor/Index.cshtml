@{
    ViewData["Title"] = "เลือกแผนก";
    Layout = "_NavLayout";
    var depts = ViewBag.DeptList as List<Department>;
    var services = ViewBag.ServiceList as List<Service>;
}

<style>
    .department-page {
        --department-blue: #2878df;
        --department-ink: #1d2b45;
        --department-muted: #78869b;
        color: var(--department-ink);
        padding: 8px 8px 36px;
    }

    .department-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin: 8px 0 26px;
    }

    .department-heading h1 {
        margin: 0 0 8px;
        font-size: clamp(1.55rem, 2.4vw, 2rem);
        font-weight: 750;
        letter-spacing: -.03em;
    }

    .department-heading p {
        max-width: 640px;
        margin: 0;
        color: var(--department-muted);
    }

    .department-search {
        position: relative;
        width: min(100%, 340px);
        flex: 0 0 340px;
    }

    .department-search input {
        height: 46px;
        padding-left: 42px;
        border: 1px solid #dfe6ef;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(28, 54, 91, .04);
    }

    .department-search span {
        position: absolute;
        top: 50%;
        left: 15px;
        transform: translateY(-50%);
        color: #8090a7;
        pointer-events: none;
    }

    .department-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
    }

    .department-toolbar h2 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
    }

    .department-count {
        color: var(--department-muted);
        font-size: .9rem;
    }

    .department-card {
        height: 100%;
        overflow: hidden;
        border: 1px solid #e6ebf2;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 8px 24px rgba(29, 52, 83, .06);
        transition: transform .18s ease, box-shadow .18s ease;
    }

    .department-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 30px rgba(29, 52, 83, .12);
    }

    .department-art {
        position: relative;
        display: grid;
        min-height: 178px;
        place-items: center;
        overflow: hidden;
    }

    .department-art::before,
    .department-art::after {
        position: absolute;
        content: "";
        border: 1px solid rgba(255, 255, 255, .48);
        border-radius: 50%;
    }

    .department-art::before {
        width: 190px;
        height: 190px;
    }

    .department-art::after {
        width: 145px;
        height: 145px;
    }

    .department-art--1 { background: linear-gradient(135deg, #dceeff, #9dc9f7); }
    .department-art--2 { background: linear-gradient(135deg, #e1f8f2, #9eddd0); }
    .department-art--3 { background: linear-gradient(135deg, #ffe9e2, #ffc4b4); }
    .department-art--4 { background: linear-gradient(135deg, #eee9ff, #c8baf8); }
    .department-art--5 { background: linear-gradient(135deg, #fff4d8, #f8d88d); }
    .department-art--6 { background: linear-gradient(135deg, #e2f1f3, #a9d8df); }

    .department-art__icon {
        z-index: 1;
        display: grid;
        width: 92px;
        height: 92px;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, .7);
        border-radius: 28px;
        background: rgba(255, 255, 255, .76);
        box-shadow: 0 10px 24px rgba(31, 69, 112, .12);
        color: var(--department-blue);
        font-size: 3rem;
        line-height: 1;
    }

    .department-art__badge {
        position: absolute;
        top: 14px;
        right: 14px;
        z-index: 1;
        padding: 6px 10px;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: 999px;
        background: rgba(255, 255, 255, .85);
        color: #2f6d54;
        font-size: .75rem;
        font-weight: 650;
    }

    .department-card__body {
        padding: 18px 18px 12px;
    }

    .department-card__title {
        margin: 0 0 8px;
        font-size: 1.08rem;
        font-weight: 720;
    }

    .department-card__description {
        min-height: 42px;
        margin: 0 0 14px;
        color: var(--department-muted);
        font-size: .9rem;
        line-height: 1.55;
    }

    .department-services {
        padding-top: 12px;
        border-top: 1px solid #edf1f5;
    }

    .department-services__heading {
        margin-bottom: 6px;
        color: #66758b;
        font-size: .78rem;
        font-weight: 700;
    }

    .department-service {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 5px 0;
        color: #53627a;
        font-size: .82rem;
    }

    .department-service__name {
        min-width: 0;
    }

    .department-service__price {
        flex: 0 0 auto;
        color: #334968;
        font-weight: 650;
    }

    .department-card__footer {
        padding: 0 18px 18px;
    }

    .department-card__button {
        width: 100%;
        padding: 10px 14px;
        border-radius: 10px;
        background: var(--department-blue);
        font-weight: 650;
    }

    .department-card__button:hover {
        background: #1b65c4;
    }

    .department-empty {
        padding: 36px 16px;
        border: 1px dashed #cbd6e4;
        border-radius: 14px;
        color: var(--department-muted);
        text-align: center;
    }

    @@media (max-width: 767.98px) {
        .department-page { padding: 0 0 24px; }
        .department-heading { align-items: stretch; flex-direction: column; }
        .department-search { width: 100%; flex-basis: auto; }
        .department-art { min-height: 150px; }
    }
</style>

<section class="department-page">
    @if (TempData["LoginSuccess"] is string name)
    {
        <div class="alert alert-success">เข้าสู่ระบบสำเร็จ คุณ @name</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }

    <header class="department-heading">
        <div>
            <div class="text-primary fw-semibold small mb-2">นัดหมายแพทย์ · ขั้นตอนที่ 1 จาก 4</div>
            <h1>เลือกแผนกและศูนย์การแพทย์</h1>
            <p>เลือกแผนกที่ต้องการเข้ารับบริการ หรือค้นหาแพทย์เพื่อเริ่มต้นนัดหมาย</p>
        </div>
        <label class="department-search">
            <span aria-hidden="true">⌕</span>
            <input id="department-search" class="form-control" type="search"
                   placeholder="ค้นหาแผนกหรือบริการ..." aria-label="ค้นหาแผนกหรือบริการ">
        </label>
    </header>

    <div class="department-toolbar">
        <h2>แผนกทั้งหมด</h2>
        <span class="department-count"><span id="department-result-count">@depts.Count</span> แผนก</span>
    </div>

    <div class="row g-4" id="department-grid">
        @{
            var departmentIndex = 0;
        }
        @foreach (var dp in depts)
        {
            var departmentServices = services.Where(x => x.DepartmentId == dp.DepartmentId).ToList();
            var searchText = $"{dp.DepartmentName} {dp.Description} {string.Join(" ", departmentServices.Select(x => x.ServiceName))}";
            var icon = "✚";
            if (dp.DepartmentName.Contains("เด็ก") || dp.DepartmentName.Contains("Pedi", StringComparison.OrdinalIgnoreCase))
            {
                icon = "🧸";
            }
            else if (dp.DepartmentName.Contains("หัวใจ") || dp.DepartmentName.Contains("Cardio", StringComparison.OrdinalIgnoreCase))
            {
                icon = "♡";
            }
            else if (dp.DepartmentName.Contains("กระดูก") || dp.DepartmentName.Contains("Ortho", StringComparison.OrdinalIgnoreCase))
            {
                icon = "✣";
            }
            else if (dp.DepartmentName.Contains("ตา") || dp.DepartmentName.Contains("Ophthalm", StringComparison.OrdinalIgnoreCase))
            {
                icon = "◉";
            }
            else if (dp.DepartmentName.Contains("สมอง") || dp.DepartmentName.Contains("Neuro", StringComparison.OrdinalIgnoreCase))
            {
                icon = "⌘";
            }

            var artClass = $"department-art--{departmentIndex % 6 + 1}";
            departmentIndex++;

            <div class="col-xl-4 col-md-6 department-card-wrap" data-search="@searchText">
                <article class="department-card">
                    <div class="department-art @artClass">
                        <span class="department-art__badge">บริการทางการแพทย์</span>
                        <span class="department-art__icon" aria-hidden="true">@icon</span>
                    </div>
                    <div class="department-card__body">
                        <h3 class="department-card__title">@dp.DepartmentName</h3>
                        <p class="department-card__description">
                            @(string.IsNullOrWhiteSpace(dp.Description) ? "ดูแลและให้คำปรึกษาโดยทีมบุคลากรทางการแพทย์" : dp.Description)
                        </p>

                        @if (departmentServices.Count > 0)
                        {
                            <div class="department-services">
                                <div class="department-services__heading">บริการในแผนก (@departmentServices.Count)</div>
                                @foreach (var sv in departmentServices)
                                {
                                    <div class="department-service">
                                        <span class="department-service__name">@sv.ServiceName</span>
                                        <span class="department-service__price">@sv.Price.ToString("N2") บาท</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="department-card__footer">
                        <a class="btn btn-primary department-card__button"
                           asp-controller="Doctor" asp-action="SelectDoctor"
                           asp-route-UserId="@ViewBag.UserId" asp-route-DepartmentId="@dp.DepartmentId">
                            เลือกแผนกนี้ <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </article>
            </div>
        }
    </div>

    <div id="department-empty" class="department-empty mt-4" hidden>
        ไม่พบแผนกหรือบริการที่ตรงกับคำค้นหา
    </div>

    <div class="d-flex justify-content-center mt-4">
        <a class="btn btn-outline-primary px-4" asp-controller="Doctor" asp-action="SelectDoctor"
           asp-route-UserId="@ViewBag.UserId">ค้นหาแพทย์ทั้งหมด</a>
    </div>
</section>

<script>
    (() => {
        const searchInput = document.getElementById("department-search");
        const cards = Array.from(document.querySelectorAll(".department-card-wrap"));
        const resultCount = document.getElementById("department-result-count");
        const emptyState = document.getElementById("department-empty");

        searchInput.addEventListener("input", () => {
            const query = searchInput.value.trim().toLocaleLowerCase();
            let visibleCount = 0;

            cards.forEach((card) => {
                const matches = card.dataset.search.toLocaleLowerCase().includes(query);
                card.hidden = !matches;
                if (matches) visibleCount++;
            });

            resultCount.textContent = visibleCount;
            emptyState.hidden = visibleCount !== 0;
        });
    })();
</script>
